node_modules/
dist/
out/
*.vsix
.vscode-test/

# License keys - never commit these
scripts/keys.json
src/license/keys.enc.local

# Environment files
.env
.env.local

# Build artifacts
*.js.map
*.d.ts.map

# Compiled artifacts in source directories (should not be committed)
webview-ui/src/**/*.js
webview-ui/src/**/*.d.ts
!webview-ui/src/**/*.test.js
!webview-ui/src/**/*.spec.js

# Test coverage
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db

# Editor directories
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude hooks (development)
.claude/hooks/lib/__pycache__/
.claude/hooks/state/
*.pyc

# Claude per-developer config (settings, hooks, plans) stays local — but
# .claude/skills/ is TRACKED: project skills are shared living documents
# (decision: .rptc/research/project-skills/research.md §3).
# NOTE: `.claude/*` not `.claude/` — git can't re-include below an excluded dir.
.claude/*
!.claude/skills/
# .claude/hooks/ + settings.json are TRACKED. A hook enforces the skills above, so
# a hook that does not travel is enforcement only one checkout has. The WIRING has
# to travel with it — that lives in settings.json (shared), NOT in
# settings.local.json (personal permissions, still ignored).
!.claude/hooks/
!.claude/settings.json
# ...but never hook runtime state or bytecode.
.claude/hooks/state/
.claude/hooks/lib/__pycache__/

# Cursor IDE rules — per-developer AI tool config, same policy as .claude/.
.cursor/

# RPTC workflow — only the working prompt is throwaway; plans, research,
# and backlog are tracked artifacts per the policy in .rptc/CLAUDE.md.
.rptc/prompt.md

# Vendor documentation exports — internal Confluence/Word exports pulled in as
# source material for research. This repo is PUBLIC, so the exports themselves
# never land in history; the durable finding gets promoted to a tracked file
# under .rptc/research/ instead (see .rptc/research/data-installer/).
docs/research/data-installer/

# Raw live-probe captures — curl output, response bodies, HAR files. A probe
# against an internal service carries endpoints, activation ids and error text
# that name internal infrastructure, and this repo is PUBLIC. Capture here,
# then write up the FINDING in a tracked `spike-*.md` with those details
# redacted (see the redaction rule in .rptc/CLAUDE.md).
.rptc/research/**/raw/
.rptc/research/**/*.probe.json
.rptc/research/**/*.probe.txt

# Analysis artifacts
report/
jscpd-output/
# Claude settings
.claude/settings.local.json  # Local overrides
.claude/.env*           # Secrets
.jest-cache/
.playwright-mcp/
.serena/

# Internal service doc drops (Adobe wiki exports) — local reference only, never published
.rptc/research/*.doc
tests/setup/console-gate-offenders.txt

# Mutation testing (Stryker) — sandbox copies of the repo + generated reports
.stryker-tmp*/
# ...but the BASELINE is the ratchet itself and must be shared. A directory
# exclusion cannot be undone by a negation inside it, hence the /* form.
reports/mutation/*
!reports/mutation/baseline.json

# jscpd working output for the health snapshot — the numbers are kept in
# reports/health/history.json; the raw report is regenerated each run.
# The load-bearing cast worklist is DERIVED — regenerate it, never read a stale copy:
#   node scripts/codemod/loadbearing-worklist.mjs > reports/loadbearing-casts.md
# It is a snapshot of what the compiler says today, and it rots the moment a cast
# moves. The generator is tracked; the output is not.
reports/loadbearing-casts.md
reports/health/.jscpd-tests/
reports/mutation/mutation.json
reports/mutation/pl22.json

# Raw stream-json from an overnight goal queue (scripts/overnight/run.sh).
# The handoff REPORTS beside these are tracked and are the record; these are
# run artifacts — 8.5 MB across two runs on 2026-09-03, and a full session
# transcript apiece. This repository is public, so they stay out of history.
.rptc/handoff/overnight-*/
