{
    "version": "1.0.0",
    "patches": [
        {
            "id": "index-product-teaser-sku",
            "pagePath": "/",
            "description": "Replace Orchard7 SKU with apple-iphone-se/iphone-se in the product teaser on the homepage",
            "searchPattern": "Orchard7",
            "replacement": "apple-iphone-se/iphone-se"
        },
        {
            "id": "phones-product-teaser-sku",
            "pagePath": "/phones",
            "description": "Replace Orchard1-1 SKU with apple-iphone-se/iphone-se in the product teaser on the phones page",
            "searchPattern": "Orchard1-1",
            "replacement": "apple-iphone-se/iphone-se"
        },
        {
            "id": "index-product-teaser-sku-accs",
            "pagePath": "/",
            "description": "Replace Orchard7 SKU with Orchard1-1 in the product teaser on the homepage (ACCS)",
            "searchPattern": "Orchard7",
            "replacement": "Orchard1-1"
        },
        {
            "id": "smart-watches-url-path",
            "pagePath": "/smart-watches",
            "description": "Replace urlPath smart-watches with watches in the product-list-page block on the smart-watches page",
            "searchPattern": "<div>smart-watches</div>",
            "replacement": "<div>watches</div>"
        },
        {
            "id": "nav-create-account-link",
            "pagePath": "/nav",
            "description": "Fix nav registration link from /customer/create to /customer/create-account to match path constant",
            "searchPattern": "href=\"/customer/create\"",
            "replacement": "href=\"/customer/create-account\""
        }
    ]
}
