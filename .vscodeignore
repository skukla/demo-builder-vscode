# Source files (bundled by esbuild)
.vscode/**
.vscode-test/**
src/**
webview-ui/**

# Include feature config files loaded at runtime via fs (not bundled by esbuild)
!src/features/*/config/**/*.json
!src/core/*/config/**/*.json

# Dependencies (bundled by esbuild)
node_modules/**

# Development tool caches — never part of the extension
.serena/**
.playwright-mcp/**
# Added 2026-08-15: jest's transform cache moved in-repo on 2026-08-13
# (`cacheDirectory: '<rootDir>/.jest-cache/...'`) and nothing here excluded it, so
# beta.129 packaged 5,027 cache files — 58.6 MB, 98% of the VSIX by file count.
# `.gitignore` lists it, which does NOT help: vsce reads .vscodeignore INSTEAD of
# .gitignore whenever this file exists.
.jest-cache/**
# Editor config, same reasoning.
.cursor/**
# Added 2026-09-08 with PL-46's UI tier, for exactly the reason above. ExTester
# downloads a VS Code build and the extension under test into these; measured the
# day they appeared, `.test-extensions/` alone was 329 MB across 1,571 files. Both
# are in .gitignore, which does NOT help — vsce reads THIS file instead whenever
# it exists, which is what let beta.129 ship a 58.6 MB jest cache.
.test-extensions/**
test-resources/**

# TypeScript-compiled individual JS files are redundant: esbuild bundles
# everything into dist/extension.js. Only the esbuild outputs are needed.
dist/commands/**
dist/core/**
dist/features/**
dist/types/**
dist/utils/**

# Source maps (development only)
dist/**/*.map

# Build / tooling config.
#
# GLOBS, not individual names. This list named each config file one by one, and
# every sibling added since slipped through: on 2026-09-08 `vsce ls` showed eleven
# dev-tooling files being packaged — four jest configs, four stryker configs, two
# extra eslint configs and tsconfig.test.json. Only 26 KB, so the cost was noise
# rather than size, but naming files individually guarantees the next one ships
# too. Patterns cover the siblings that do not exist yet.
.gitignore
.eslintrc.json
tsconfig*.json
webpack.config.js
esbuild.config.js
eslint*.mjs
stryker*.json
jest*.config.js
.prettierignore
.swcrc
package.json.backup
package-lock.json

# Development files
**/*.ts
**/.git/**
.github/**
test/**
tests/**
docs/**
coverage/**
.rptc/**
.claude/**
.githooks/**

# Measurement output. This said `report/**` — SINGULAR — and the directory has
# always been `reports/`, so beta.145 packaged 625 mutation-report files, 144 MB
# on disk. Found 2026-09-08 by reading what `npm run test:ui` packaged, which is
# the third time a local artifact directory has shipped this way after the jest
# cache and the ExTester downloads above. The lesson each time is the same: a
# directory being in `.gitignore` does nothing, because vsce reads THIS file
# instead whenever it exists.
reports/**

# The mutation SANDBOX, which is not the same directory as the reports above and
# was missed when they were fixed. Stryker copies the entire repo into
# `.stryker-tmp/sandbox-<id>/` to mutate it, and leaves it behind.
#
# Caught 2026-09-10 while cutting beta.146: the release-cut sweep runs
# `mutation-test-pilot`, `npm run package` ran minutes later, and the VSIX went
# out at 41.2 MB against beta.145's 7.7 MB — 112 MB and 8,836 files of sandbox,
# five times the whole extension. It had never happened before because the sweep
# and the packaging do not normally run within minutes of each other, which is
# precisely the kind of gap a per-release eyeball never closes.
#
# Same lesson as the entry above, for the fourth time: `.gitignore` covers this
# path (line 102) and that is worth NOTHING here — vsce reads THIS file instead
# whenever it exists, so a directory hidden from git is invisible to review and
# still ships. Pinned by tests/sop/vsix-contents.test.ts.
.stryker-tmp*/**

# Build and quality tooling. Nothing in `scripts/` runs at extension runtime —
# checked 2026-09-08: every `scripts/` path in `src/` refers to a file inside a
# STOREFRONT repo, not this one, and no code spawns a node script from the
# extension directory. This previously excluded one file by name and shipped the
# other 72.
scripts/**

# Dev-tooling dotfiles at the root, by pattern rather than by name for the same
# reason as the config globs above.
.gitguardian.yaml
.madgerc
.pre-commit-config.yaml
.testfilesizerc.json

# Documentation (keep README and CHANGELOG)
*.md
!README.md
!CHANGELOG.md
