{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-changed.sh\"",
            "statusMessage": "eslint (changed files)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/doc-drift.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/deletion-scan-router.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/component-reuse-check.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rptc-record-drift.sh\"",
            "statusMessage": "rptc record drift"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|WebFetch|WebSearch|mcp__adobe-exl__.*|mcp__fluffyjaws__.*|mcp__helix-mcp-server__aem-docs-search|mcp__MCP_DOCKER__fetch|mcp__MCP_DOCKER__resolve-library-id|mcp__MCP_DOCKER__get-library-docs|mcp__MCP_DOCKER__perplexity_.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/router.sh\"",
            "statusMessage": "hook router"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.sh\"",
            "statusMessage": "prettier+eslint --fix (edited file)"
          }
        ]
      }
    ]
  }
}
